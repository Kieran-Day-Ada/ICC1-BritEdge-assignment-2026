# Copy this file to .env and fill in your own values.
# .env is already excluded via .gitignore - never commit real credentials.
#
# Leave AZURE_SQL_SERVER, PG_HOST, and COSMOS_ENDPOINT unset to use the built-in
# SQLite database - no configuration needed.

SECRET_KEY=change-me-to-a-long-random-string

# --- Choose ONE database backend below (or leave all unset for SQLite) ---

# 1. SQL (Azure SQL Database).
# AZURE_SQL_SERVER=<server-name>.database.windows.net
# AZURE_SQL_USER=<sql-admin-or-contained-user>
# AZURE_SQL_PASSWORD=<sql-password>
# Optional Azure SQL overrides (defaults shown)
# AZURE_SQL_PORT=1433
# AZURE_SQL_DATABASE=master
# AZURE_SQL_DRIVER=ODBC Driver 18 for SQL Server

# 2. SQL (PostgreSQL): a real SQL database such as Azure Database for PostgreSQL.
# PG_HOST=<postgres-hostname>
# PG_USER=<postgres-username>
# PG_PASSWORD=<postgres-password>
# Optional SQL overrides (defaults shown)
# PG_PORT=5432
# PG_DATABASE=postgres

# 3. NoSQL: Azure Cosmos DB for NoSQL (documents). Setting COSMOS_ENDPOINT
#    switches the app to this backend, even if SQL variables are also set.
# COSMOS_ENDPOINT=https://<your-account>.documents.azure.com:443/
# COSMOS_KEY=<your-cosmos-primary-key>

# Optional Cosmos overrides (defaults shown)
# COSMOS_DB=BritEdgeDB
# COSMOS_USERS_CONTAINER=users
# COSMOS_JOBS_CONTAINER=jobs
