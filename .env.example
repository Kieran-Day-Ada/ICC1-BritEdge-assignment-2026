# Copy this file to .env and fill in your own values.
# .env is already excluded via .gitignore - never commit real credentials.
#
# Leave DATABASE_URL and COSMOS_ENDPOINT both unset to use the built-in
# SQLite database - no configuration needed.

SECRET_KEY=change-me-to-a-long-random-string

# --- Choose ONE database backend below (or leave both unset for SQLite) ---

# 1. SQL: a real SQL database such as Azure Database for PostgreSQL.
# DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database_name>

# 2. NoSQL: Azure Cosmos DB for NoSQL (documents). Setting COSMOS_ENDPOINT
#    switches the app to this backend, even if DATABASE_URL is also set.
# COSMOS_ENDPOINT=https://<your-account>.documents.azure.com:443/
# COSMOS_KEY=<your-cosmos-primary-key>

# Optional Cosmos overrides (defaults shown)
# COSMOS_DB=BritEdgeDB
# COSMOS_USERS_CONTAINER=users
# COSMOS_JOBS_CONTAINER=jobs
